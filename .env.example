# YouTube / Google OAuth
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Go to Credentials → Create OAuth 2.0 Client ID (Web application)
# 4. Add http://localhost:3001/auth/youtube/callback as an Authorized redirect URI
# 5. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Instagram API (Instagram Login — requires Business or Creator account)
# 1. Go to https://developers.facebook.com/ → Create app → Business type
# 2. Add the "Instagram" product to your app
# 3. Under Instagram → Settings, add your Instagram test account
# 4. Add http://localhost:3001/auth/instagram/callback as a Valid OAuth Redirect URI
# 5. Copy the App ID and App Secret below

INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:3001/auth/instagram/callback

# xAI (Grok) API (powers AI content suggestions in Insights)
# 1. Go to https://console.x.ai/
# 2. Create an API key
# 3. Copy it below

XAI_API_KEY=your_xai_api_key_here

# These defaults work for local development
REDIRECT_URI=http://localhost:3001/auth/youtube/callback
FRONTEND_URL=http://localhost:5173
PORT=3001
